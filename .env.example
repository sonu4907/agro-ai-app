# Recommended primary key for the backend
GEMINI_API_KEY=AIzaSy...

# Backup alias supported by the backend
GOOGLE_API_KEY=AIzaSy...

# Dedicated API Keys for specific functions (to prevent 15 RPM rate limits)
GEMINI_SCAN_API_KEY=AIzaSy...
GEMINI_CHAT_API_KEY=AIzaSy...
GEMINI_IRRIGATION_API_KEY=AIzaSy...
GEMINI_ROTATION_API_KEY=AIzaSy...

OPENROUTER_API_KEY=replace_with_openrouter_key
OPENROUTER_MODEL=google/gemini-2.5-flash
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
GARDEN_DEVICE_TOKEN=replace_with_a_long_random_device_token
GARDEN_ADMIN_USERNAME=replace_with_garden_admin_username
GARDEN_ADMIN_PASSWORD=replace_with_a_strong_garden_admin_password
